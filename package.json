{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:live": "BASE_URL=https://chipper-ui.fly.dev API_URL=https://wci-api.fly.dev playwright test",
    "test:e2e:accessibility": "playwright test --grep accessibility",
    "test:e2e:functional": "playwright test --grep functional",
    "test:e2e:labels": "playwright test --grep label",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dft:audit": "tsx scripts/dft-audit.ts",
    "dft:audit:strict": "tsx scripts/dft-audit.ts --strict",
    "gate": "bash scripts/pre-commit-gate.sh",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "@effect/schema": "^0.75.5",
    "effect": "^3.21.4",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xstate": "^5.32.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.42",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
