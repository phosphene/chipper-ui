        >
          <p
            class="text-sm font-semibold text-gray-900"
          >
            ORCID work record
          </p>
          <p
            class="text-xs mt-0.5 text-gray-500"
          >
            Push to your ORCID profile
          </p>
        </button>
        <button
          class="w-full text-left px-5 py-4 rounded-xl border-2 transition-all
                    border-gray-200 bg-white text-gray-900 hover:border-gray-400"
          data-testid="route-doi"
        >
          <p
            class="text-sm font-semibold text-gray-900"
          >
            DOI via Zenodo
          </p>
          <p
            class="text-xs mt-0.5 text-gray-500"
          >
            Mint a citable DOI for preprints and reports
          </p>
        </button>
        <button
          class="w-full text-left px-5 py-4 rounded-xl border-2 transition-all
                    border-gray-200 bg-white text-gray-900 hover:border-gray-400"
          data-testid="route-arxiv"
        >
          <p
            class="text-sm font-semibold text-gray-900"
          >
            arXiv deposit
