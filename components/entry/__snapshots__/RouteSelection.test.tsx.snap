        </button>
      </div>
    </div>
    <button
      class="w-full py-4 rounded-xl text-sm font-medium transition-all
          bg-gray-200 text-gray-400 cursor-not-allowed"
      data-testid="layer-3-proceed"
      disabled=""
    >
      Proceed →
    </button>
  </div>
</div>
